###############################################
## 1. 加载包
###############################################
library(tidyverse)
library(lubridate)
library(mgcv)

###############################################
## 2. 读入并合并所有 CSV
##   假设 CSV 文件放在当前工作目录
##   例如: "M377_merged.csv", "M379_merged.csv", ...
###############################################

# 如果你在 Rstudio 里, 可以 setwd("你的目录")，这里就省略了
file_list <- c("M377_merged.csv",
               "M379_merged.csv",
               "M380_merged.csv",
               "M382_merged.csv",
               "M383_merged.csv")

raw_list <- lapply(file_list, read.csv, stringsAsFactors = FALSE)
dat_raw  <- bind_rows(raw_list)

###############################################
## 3. 基本预处理 & 改列名
###############################################

dat <- dat_raw %>%
  # 改几个名字方便写公式（原列名里有空格/括号）
  rename(
    Ta       = `Ta(ambient_temp)`,
    cum_food = `Cumulative_Food_intake (g0`
  ) %>%
  # 转时间格式
  mutate(
    date_time_corrected = ymd_hms(date_time_corrected),
    # 提取小时 (0–24) 做 time-of-day
    tod = hour(date_time_corrected) + minute(date_time_corrected) / 60
  ) %>%
  # 把 Phase / Sleep 之类转成因子
  mutate(
    Phase_lbl = factor(Phase_lbl),
    Sleep     = factor(Sleep),
    MouseID   = factor(MouseID)
  )

###############################################
## 4. (示例) 定义 torpor 变量 —— 必须按你自己的标准改 !!!
###############################################
## 这里只是一个非常粗糙的例子：
## 假设 torpor 时 Tb 下降 + 代谢 (TEE) 很低
## 你需要根据生理标准改阈值/规则 !!!

dat <- dat %>%
  group_by(MouseID) %>%
  mutate(
    # 下面是示例：Tb < 32°C 且 TEE 在该鼠的后10%分位以下
    # TODO: 按你自己的 torpor 判定标准修改这一行！！！
    torpor = if_else(
      Tb_dsi < 32 &
        TEE <= quantile(TEE, 0.10, na.rm = TRUE),
      1L, 0L
    )
  ) %>%
  ungroup()

# 只保留需要的变量并去掉 NA
dat <- dat %>%
  select(
    torpor, MouseID, date_time_corrected,
    Ta, cum_food, tod, age, BW_start, BW_end,
    TEE, VO2, Phase_lbl, Tb_dsi, Activity_dsi, Sleep, Wake
  ) %>%
  drop_na(torpor, Ta, cum_food, tod, age, BW_start)

###############################################
## 5. 构建 time-of-day 的周期变量 & 标准化线性变量
###############################################

dat <- dat %>%
  mutate(
    # 转成 0~2π 的角度，做周期平滑
    tod_rad = tod / 24 * 2 * pi,
    # 标准化年龄和体重，方便比较效应大小
    age_z      = as.numeric(scale(age)),
    BW_start_z = as.numeric(scale(BW_start))
  )

###############################################
## 6. 建立 "全模型" GAMM
##    - torpor 为 0/1 (二项分布 + logit link)
##    - Ta / cum_food / tod_rad 非线性平滑
##    - age_z, BW_start_z 线性
##    - (1 | MouseID) 随机截距
###############################################

# 注意: bs="cc" 是周期平滑，需要指定 knots
knots_list <- list(tod_rad = c(0, 2 * pi))

m_full <- gamm(
  torpor ~
    s(Ta,       k = 5) +             # Ta 非线性
    s(cum_food, k = 5) +             # 累积进食非线性
    s(tod_rad,  bs = "cc", k = 6) +  # 时间-of-day 的周期非线性
    age_z + BW_start_z,              # 年龄、体重线性
  random = list(MouseID = ~ 1),
  family = binomial,
  data   = dat,
  knots  = knots_list
)

# 看一下平滑项信息
summary(m_full$gam)
# 画出平滑曲线 (f(Ta), f(cum_food), f(tod_rad))
plot(m_full$gam, pages = 1, shade = TRUE)

###############################################
## 7. 用 "删掉一个变量" 比较 ΔAIC → 重要性排序
###############################################

# 去掉 Ta
m_noTa <- gamm(
  torpor ~
    s(cum_food, k = 5) +
    s(tod_rad,  bs = "cc", k = 6) +
    age_z + BW_start_z,
  random = list(MouseID = ~ 1),
  family = binomial,
  data   = dat,
  knots  = knots_list
)

# 去掉 cum_food
m_noFood <- gamm(
  torpor ~
    s(Ta, k = 5) +
    s(tod_rad, bs = "cc", k = 6) +
    age_z + BW_start_z,
  random = list(MouseID = ~ 1),
  family = binomial,
  data   = dat,
  knots  = knots_list
)

# 去掉 tod_rad (时间-of-day)
m_noTod <- gamm(
  torpor ~
    s(Ta, k = 5) +
    s(cum_food, k = 5) +
    age_z + BW_start_z,
  random = list(MouseID = ~ 1),
  family = binomial,
  data   = dat
)

# 去掉 age_z
m_noAge <- gamm(
  torpor ~
    s(Ta, k = 5) +
    s(cum_food, k = 5) +
    s(tod_rad, bs = "cc", k = 6) +
    BW_start_z,
  random = list(MouseID = ~ 1),
  family = binomial,
  data   = dat,
  knots  = knots_list
)

# 去掉 BW_start_z
m_noBW <- gamm(
  torpor ~
    s(Ta, k = 5) +
    s(cum_food, k = 5) +
    s(tod_rad, bs = "cc", k = 6) +
    age_z,
  random = list(MouseID = ~ 1),
  family = binomial,
  data   = dat,
  knots  = knots_list
)

# 汇总 AIC (注意用 $lme)
aic_tab <- AIC(
  full   = m_full$lme,
  noTa   = m_noTa$lme,
  noFood = m_noFood$lme,
  noTod  = m_noTod$lme,
  noAge  = m_noAge$lme,
  noBW   = m_noBW$lme
) %>%
  as.data.frame() %>%
  rownames_to_column("model") %>%
  arrange(AIC) %>%
  mutate(delta_AIC = AIC - min(AIC))

print(aic_tab)

## 解读：
## - 行数最上面 AIC 最小的是“最好”的模型
## - 某个变量被删掉后，delta_AIC 越大 -> 这个变量对模型贡献越大 -> 越重要

###############################################
## 8. 用 "Δp" 衡量每个因素把 torpor 概率推多远
###############################################

## 帮你写一个函数：固定其他变量在均值，
## 只让某一个变量在观测范围内变化，
## 看 torpor 概率的最大/最小值差 Δp

effect_delta_p <- function(var_name, n_grid = 100) {
  # 取各变量的典型值（均值）
  base <- dat %>%
    summarise(
      Ta       = mean(Ta,       na.rm = TRUE),
      cum_food = mean(cum_food, na.rm = TRUE),
      tod_rad  = mean(tod_rad,  na.rm = TRUE),
      age_z      = mean(age_z,      na.rm = TRUE),
      BW_start_z = mean(BW_start_z, na.rm = TRUE)
    )

  # 该变量的范围（这里用 10% ~ 90% 分位数避免极端值）
  q <- quantile(dat[[var_name]], probs = c(0.1, 0.9), na.rm = TRUE)
  grid_vals <- seq(q[1], q[2], length.out = n_grid)

  # 构造 newdata，只改变 var_name，其它用 base 值
  newdat <- base[rep(1, n_grid), ]
  newdat[[var_name]] <- grid_vals
  # MouseID 写 NA，让预测用 population-level
  newdat$MouseID <- NA

  # 预测概率
  p <- predict(m_full$gam, newdata = newdat, type = "response")
  c(
    var   = var_name,
    p_min = min(p),
    p_max = max(p),
    delta_p = max(p) - min(p)
  )
}

# 对 Ta / cum_food / tod_rad 各算一遍
dp_Ta      <- effect_delta_p("Ta")
dp_food    <- effect_delta_p("cum_food")
dp_tod_rad <- effect_delta_p("tod_rad")

delta_p_tab <- rbind(dp_Ta, dp_food, dp_tod_rad) %>%
  as.data.frame()

print(delta_p_tab)

## 解读：
## - 对每个变量，在其常见范围(10%~90%分位)内变化时，
##   torpor 概率从 p_min 到 p_max，
##   差值 delta_p 越大 -> 说明这个变量在生理上“能把 torpor 概率推得更厉害” -> 越重要

