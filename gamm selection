# ------------------------------------------------
# 7. 删掉一个变量，比较 AIC（ΔAIC 用来看重要性）
# ------------------------------------------------
def fit_gam_on_features(cols):
    """
    给定要用的列名，拟合一个 GAM 并返回模型
    注意：这里的 X_sub 维度 = len(cols)，所以要重新构造 s(0)+s(1)+...
    """
    X_sub = df[cols].values
    n_feats = X_sub.shape[1]

    # 构造 term 列表：s(0) + s(1) + ... + s(n_feats-1)
    if n_feats == 1:
        terms = s(0)
    else:
        terms = s(0)
        for j in range(1, n_feats):
            terms = terms + s(j)

    model = LogisticGAM(terms).fit(X_sub, y)
    return model

results_aic = []

for drop_col in feature_cols:
    cols = [c for c in feature_cols if c != drop_col]
    gam_sub = fit_gam_on_features(cols)
    aic_sub = gam_sub.statistics_["AIC"]
    results_aic.append({"dropped": drop_col, "AIC": aic_sub})

aic_df = pd.DataFrame(results_aic)
aic_df["AIC_full"] = gam_full.statistics_["AIC"]
aic_df["delta_AIC"] = aic_df["AIC"] - aic_df["AIC_full"]

print("删掉每个变量后的 AIC 对比（按 delta_AIC 排序）：")
print(aic_df.sort_values("delta_AIC"))
print("-" * 60)

# ------------------------------------------------
# 8. 计算每个变量的 Δp（在合理范围内能把 torpor 概率推多远）
# ------------------------------------------------
def delta_p_for_variable(var_name, n_grid=100):
    """
    固定其他变量在均值，
    只让 var_name 在 10%~90% 分位数范围内变化，
    用 full GAM 预测 torpor 概率，
    返回 p_min, p_max, delta_p
    """
    base = df[feature_cols].mean()

    q10, q90 = df[var_name].quantile([0.1, 0.9])
    grid = np.linspace(q10, q90, n_grid)

    rows = []
    for val in grid:
        row = base.copy()
        row[var_name] = val
        rows.append(row)

    X_grid = np.vstack(rows)
    p = gam_full.predict_proba(X_grid)

    return {
        "var": var_name,
        "p_min": float(p.min()),
        "p_max": float(p.max()),
        "delta_p": float(p.max() - p.min())
    }

delta_p_list = [delta_p_for_variable(v) for v in feature_cols]
delta_p_df = pd.DataFrame(delta_p_list)

print("各变量 Δp（在常见范围内对 torpor 概率的影响幅度，按 delta_p 排序）：")
print(delta_p_df.sort_values("delta_p", ascending=False))
print("-" * 60)

print("✅ 全部计算完成：现在可以根据 delta_AIC 和 delta_p 来比较各因素的重要性。")
