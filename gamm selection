# 1. 导入包
import pandas as pd
import numpy as np
from math import pi
from pygam import LogisticGAM, s
import matplotlib.pyplot as plt

# ------------------------------------------------
# 2. 读入并合并 5 个 CSV
# ------------------------------------------------
file_list = [
    "M377_merged.csv",
    "M379_merged.csv",
    "M380_merged.csv",
    "M382_merged.csv",
    "M383_merged.csv",
]

dfs = [pd.read_csv(f) for f in file_list]
df = pd.concat(dfs, ignore_index=True)

print("合并后的数据形状:", df.shape)
print("原始列名：")
print(df.columns.tolist())
print("-" * 60)

# ------------------------------------------------
# 3. 重命名列 + 时间处理 + 类别变量
# ------------------------------------------------

# 3.1 重命名 Ta
if "Ta(ambient_temp)" in df.columns:
    df = df.rename(columns={"Ta(ambient_temp)": "Ta"})
elif "Ta" not in df.columns:
    raise ValueError("找不到环境温度列，请检查是否有 'Ta(ambient_temp)' 或 'Ta'。")

# 3.2 找到累积进食列，重命名为 cum_food
if "cum_food" not in df.columns:
    candidates = [c for c in df.columns if "Cumulative_Food" in c or "cum_food" in c]
    if len(candidates) == 0:
        raise ValueError("找不到累积进食列（包含 'Cumulative_Food' 或 'cum_food' 的列），请检查列名。")
    print("检测到累积进食列，将其重命名为 'cum_food'：", candidates[0])
    df = df.rename(columns={candidates[0]: "cum_food"})

# 3.3 时间处理
if "date_time_corrected" not in df.columns:
    raise ValueError("找不到 'date_time_corrected' 列，请检查列名。")

df["date_time_corrected"] = pd.to_datetime(df["date_time_corrected"])
df["tod"] = df["date_time_corrected"].dt.hour + df["date_time_corrected"].dt.minute / 60.0

# 3.4 转成类别类型（如果存在）
for col in ["Phase_lbl", "Sleep", "Wake", "MouseID", "Cage"]:
    if col in df.columns:
        df[col] = df[col].astype("category")

print("重命名后列名：")
print(df.columns.tolist())
print("-" * 60)

# ------------------------------------------------
# 4. 定义 torpor（二元变量）—— 示例规则
#    ⚠️ 以后可以在这里换成自己的判定标准
# ------------------------------------------------
required_for_torpor = ["Tb_dsi", "TEE", "MouseID"]
for col in required_for_torpor:
    if col not in df.columns:
        raise ValueError(f"定义 torpor 需要列 {col}，但数据中没有，请检查。")

# 对每只鼠计算 TEE 的 10% 分位数
q10 = df.groupby("MouseID")["TEE"].transform(lambda x: x.quantile(0.10))

# 示例规则：Tb_dsi < 32 且 TEE <= 自身10%分位数 -> torpor = 1
# TODO：以后你可以把这一行改成你自己的判定规则
df["torpor"] = np.where(
    (df["Tb_dsi"] < 32) & (df["TEE"] <= q10),
    1,
    0
).astype(int)

print("torpor=1 的比例:", df["torpor"].mean())
print("-" * 60)

# ------------------------------------------------
# 5. 选择变量、去 NA、构造特征
# ------------------------------------------------
needed_cols = [
    "torpor", "MouseID", "date_time_corrected",
    "Ta", "cum_food", "tod",
    "age", "BW_start", "BW_end",
    "TEE", "VO2",
    "Phase_lbl", "Tb_dsi", "Activity_dsi", "Sleep", "Wake"
]

cols_existing = [c for c in needed_cols if c in df.columns]
df = df[cols_existing].copy()
print("用于分析的数据列：", df.columns.tolist())

# 去掉关键变量缺失的行
for col in ["torpor", "Ta", "cum_food", "tod", "age", "BW_start"]:
    if col not in df.columns:
        raise ValueError(f"分析需要列 {col}，请检查数据。")
    df = df[df[col].notna()]

print("去掉 NA 后数据形状:", df.shape)

# 构造 time-of-day 的周期特征
df["tod_rad"] = df["tod"] / 24.0 * 2 * pi

# 标准化年龄和体重（注意 std=0 的情况）
age_std = df["age"].std()
if age_std == 0 or np.isnan(age_std):
    print("警告：age 标准差为 0，视为常数变量，age_z 全部设为 0。")
    df["age_z"] = 0.0
else:
    df["age_z"] = (df["age"] - df["age"].mean()) / age_std

bw_std = df["BW_start"].std()
if bw_std == 0 or np.isnan(bw_std):
    print("警告：BW_start 标准差为 0，视为常数变量，BW_start_z 全部设为 0。")
    df["BW_start_z"] = 0.0
else:
    df["BW_start_z"] = (df["BW_start"] - df["BW_start"].mean()) / bw_std

feature_cols = ["Ta", "cum_food", "tod_rad", "age_z", "BW_start_z"]

# 把 Inf 换成 NaN 再统一丢掉
df = df.replace([np.inf, -np.inf], np.nan)
df = df.dropna(subset=feature_cols + ["torpor"])

X = df[feature_cols].values
y = df["torpor"].values

print("特征列：", feature_cols)
print("X 形状:", X.shape, "y 形状:", y.shape)
print("X 中是否有 NaN：", np.isnan(X).any())
print("-" * 60)

# ------------------------------------------------
# 6. 拟合非线性 Logistic GAM（全模型）
# ------------------------------------------------
gam_full = LogisticGAM(
    s(0) + s(1) + s(2) + s(3) + s(4)
).fit(X, y)

print("全模型 AIC:", gam_full.statistics_["AIC"])
print(gam_full.summary())
print("-" * 60)

# 如需查看每个变量的非线性曲线，可解开下面注释：
