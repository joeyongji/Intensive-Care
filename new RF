"""
VO2 regression from Time, Tcore, Activity, HeartRate, Sex
- Loads multi-sheet Excel (robust to two common layouts)
- Trains on Non-torpor only (optional)
- Tunes ONCE with GroupKFold (group = Subject_ID) to avoid leakage
- Evaluates with Leave-One-Subject-Out (LOSO)
- Computes permutation importance on held-out subjects (LOSO test folds)
- Stabilizes importance by averaging across multiple random seeds

Outputs:
- metrics_*.csv
- importance_*.csv
- importance_*.png
"""

from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, Tuple, List, Optional

import numpy as np
import pandas as pd

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

from sklearn.base import clone
from sklearn.model_selection import LeaveOneGroupOut, GroupKFold, RandomizedSearchCV
from sklearn.metrics import mean_squared_error, make_scorer
from sklearn.inspection import permutation_importance
from sklearn.ensemble import RandomForestRegressor, HistGradientBoostingRegressor


# =========================================================
# 1) CONFIG
# =========================================================

XLSX_PATH = "Organized data.xlsx"   # change if needed

SHEET_CONFIG: Dict[str, Tuple[str, str]] = {
    "Tcore torpor-like": ("Tcore", "Torpor"),
    "Tcore nontorpor": ("Tcore", "Non-torpor"),
    "VO2 torpor-like": ("VO2", "Torpor"),
    "VO2 nontorpor": ("VO2", "Non-torpor"),
    "activity torpor-like": ("Activity", "Torpor"),
    "ativity nontorpor": ("Activity", "Non-torpor"),
    "Heart Rate torpor-like": ("HeartRate", "Torpor"),
    "Heart Rate nontorpor": ("HeartRate", "Non-torpor"),
}

FEATURES_WITH_TIME = ["Time", "Tcore", "Activity", "HeartRate", "Sex_Encoded"]
FEATURES_NO_TIME = ["Tcore", "Activity", "HeartRate", "Sex_Encoded"]
TARGET = "VO2"

# multi-seed stability
SEEDS = [0, 1, 2, 3, 4]
N_REPEATS_PERM = 50

# tuning
N_ITER_SEARCH = 20
INNER_SPLITS = 5

# where to save outputs
OUTDIR = Path("vo2_outputs")


# =========================================================
# 2) UTILITIES
# =========================================================

def rmse(y_true: np.ndarray, y_pred: np.ndarray) -> float:
    return float(np.sqrt(mean_squared_error(y_true, y_pred)))

# sklearn wants "higher is better" scorers -> use negative RMSE
neg_rmse_scorer = make_scorer(lambda yt, yp: -rmse(yt, yp), greater_is_better=True)


def ensure_outdir(outdir: Path) -> None:
    outdir.mkdir(parents=True, exist_ok=True)


def _looks_like_layout_A(df_raw: pd.DataFrame) -> bool:
    """
    Layout A: header=None; row0 = subject IDs (from col1 onward),
    row1 = sex labels, row2+ = time series, col0 = Time.
    Heuristic: row1 contains M/F and row0 looks like IDs (not M/F).
    """
    if df_raw.shape[0] < 3 or df_raw.shape[1] < 2:
        return False
    row0 = df_raw.iloc[0, 1:].astype(str).tolist()
    row1 = df_raw.iloc[1, 1:].astype(str).tolist()
    has_sex_row1 = any(x in {"M", "F"} for x in row1)
    row0_is_sex = any(x in {"M", "F"} for x in row0)
    return has_sex_row1 and not row0_is_sex


def _read_sheet_long(xls: pd.ExcelFile, sheet_name: str, feat_name: str, group_label: str) -> pd.DataFrame:
    """
    Reads one sheet and returns a long dataframe with columns:
    Time, Subject_ID, feat_name, Group, Sex

    Supports two common layouts:
    A) header=None; row0 IDs, row1 Sex, row2+ data, col0 Time
    B) header=0; columns include Time + subject columns; maybe first row is Sex row
    """
    # Try Layout A first
    df_raw = pd.read_excel(xls, sheet_name=sheet_name, header=None)
    if _looks_like_layout_A(df_raw):
        mouse_ids = df_raw.iloc[0, 1:].astype(str).tolist()
        sex_labels = df_raw.iloc[1, 1:].astype(str).tolist()
        sex_map = dict(zip(mouse_ids, sex_labels))

        time = pd.to_numeric(df_raw.iloc[2:, 0], errors="coerce").astype(float)
        vals = df_raw.iloc[2:, 1:]
        vals.columns = mouse_ids
        vals = vals.apply(pd.to_numeric, errors="coerce")

        df_long = vals.copy()
        df_long.insert(0, "Time", time.values)
        df_long = df_long.melt(id_vars=["Time"], var_name="Subject_ID", value_name=feat_name)
        df_long["Group"] = group_label
        df_long["Sex"] = df_long["Subject_ID"].map(sex_map)
        return df_long

    # Otherwise fallback to Layout B
    df = pd.read_excel(xls, sheet_name=sheet_name)  # header inferred

    # detect sex row in first data row (M/F scattered across columns)
    sex_map = {}
    if len(df) > 0:
        first_row = df.iloc[0].astype(str).values
        has_sex_row = np.any(np.isin(first_row, ["M", "F"]))
        if has_sex_row:
            for col in df.columns:
                v = df.iloc[0][col]
                if v in ["M", "F"]:
                    clean_col = str(col).replace("Average ", "")
                    sex_map[clean_col] = v
            df = df.drop(df.index[0]).copy()

    # clean columns
    df.columns = [str(c).replace("Average ", "") for c in df.columns]

    # time column
    time_cols = [c for c in df.columns if "time" in str(c).lower()]
    time_col = time_cols[0] if time_cols else df.columns[0]
    df = df.rename(columns={time_col: "Time"})
    df["Time"] = pd.to_numeric(df["Time"], errors="coerce")

    # subject columns
    subj_cols = [c for c in df.columns if c != "Time" and "Unnamed" not in str(c)]
    df_long = df.melt(id_vars=["Time"], value_vars=subj_cols, var_name="Subject_ID", value_name=feat_name)
    df_long[feat_name] = pd.to_numeric(df_long[feat_name], errors="coerce")
    df_long["Group"] = group_label
    df_long["Sex"] = df_long["Subject_ID"].map(sex_map)
    return df_long


def load_and_merge_all(xlsx_path: str, config: Dict[str, Tuple[str, str]]) -> pd.DataFrame:
    path = Path(xlsx_path)
    if not path.exists():
        # convenience: if running in some environments, file may be under /mnt/data
        alt = Path("/mnt/data") / xlsx_path
        if alt.exists():
            path = alt
        else:
            raise FileNotFoundError(f"Excel not found: {xlsx_path} (also tried {alt})")

    xls = pd.ExcelFile(path)
    all_dfs: List[pd.DataFrame] = []

    for sheet_name, (feat_name, group_label) in config.items():
        if sheet_name not in xls.sheet_names:
            print(f"[WARN] Missing sheet '{sheet_name}', skipping.")
            continue
        df_long = _read_sheet_long(xls, sheet_name, feat_name, group_label)
        all_dfs.append(df_long)

    if not all_dfs:
        raise ValueError("No sheets were successfully loaded. Check SHEET_CONFIG names.")

    merged = pd.concat(all_dfs, ignore_index=True)

    # Merge features onto one row per (Time, Group, Subject_ID)
    final = (
        merged
        .groupby(["Time", "Group", "Subject_ID"], as_index=False)
        .first()
    )
    return final


def encode_sex(df: pd.DataFrame) -> pd.DataFrame:
    """
    Encodes Sex as:
    M -> 0, F -> 1, unknown/missing -> -1
    (More honest than filling missing with 0.)
    """
    out = df.copy()
    mapping = {"M": 0, "F": 1}
    out["Sex_Encoded"] = out["Sex"].map(mapping).fillna(-1).astype(int)
    return out


# =========================================================
# 3) MODEL TUNING (ONCE, GROUPKFold)
# =========================================================

@dataclass(frozen=True)
class TuneSpec:
    model_name: str  # "rf" or "hgb"
    random_state: int = 0


def get_model_and_space(spec: TuneSpec):
    if spec.model_name == "rf":
        base = RandomForestRegressor(random_state=spec.random_state, n_jobs=-1)
        space = {
            "n_estimators": [300, 600, 900],
            "max_depth": [None, 8, 16, 24],
            "min_samples_leaf": [1, 2, 5],
            "max_features": ["sqrt", 0.7, 1.0],
        }
        return base, space

    if spec.model_name == "hgb":
        # HistGradientBoostingRegressor doesn't use n_jobs; it's fast enough for small data
        base = HistGradientBoostingRegressor(random_state=spec.random_state)
        space = {
            "max_iter": [200, 400, 800],
            "learning_rate": [0.03, 0.06, 0.1],
            "max_depth": [None, 3, 5, 8],
            "min_samples_leaf": [10, 20, 40],
            "l2_regularization": [0.0, 0.1, 1.0],
        }
        return base, space

    raise ValueError(f"Unknown model_name: {spec.model_name}")


def tune_once(X: pd.DataFrame, y: np.ndarray, groups: np.ndarray, spec: TuneSpec):
    base, param_dist = get_model_and_space(spec)

    n_groups = len(np.unique(groups))
    if n_groups < 2:
        raise ValueError("Need at least 2 subjects for GroupKFold tuning.")

    n_splits = min(INNER_SPLITS, n_groups)
    gkf = GroupKFold(n_splits=n_splits)

    search = RandomizedSearchCV(
        estimator=base,
        param_distributions=param_dist,
        n_iter=N_ITER_SEARCH,
        scoring=neg_rmse_scorer,
        cv=gkf.split(X, y, groups=groups),
        random_state=spec.random_state,
        n_jobs=-1,
        refit=True,
    )
    search.fit(X, y)
    print(f"[TUNE:{spec.model_name}] best params = {search.best_params_}")
    return search.best_estimator_, search.best_params_


# =========================================================
# 4) LOSO EVALUATION + HELD-OUT PERMUTATION IMPORTANCE
# =========================================================

def loso_eval_and_importance(
    tuned_estimator,
    X: pd.DataFrame,
    y: np.ndarray,
    groups: np.ndarray,
    feature_names: List[str],
    label: str,
    outdir: Path,
) -> pd.DataFrame:
    """
    For each LOSO fold, refit model and compute:
    - RMSE on held-out subject
    - permutation importance on held-out subject (repeat N_REPEATS_PERM)
    Repeated across SEEDS for stability.
    """
    ensure_outdir(outdir)
    logo = LeaveOneGroupOut()

    fold_rows = []
    perm_runs = []  # list of arrays (n_features,)

    base_params = tuned_estimator.get_params()

    for fold_idx, (tr, te) in enumerate(logo.split(X, y, groups=groups), start=1):
        subj = str(np.unique(groups[te])[0])
        Xtr, Xte = X.iloc[tr], X.iloc[te]
        ytr, yte = y[tr], y[te]

        for seed in SEEDS:
            # clone-like behavior using same tuned params but different random_state if supported
            m = clone(tuned_estimator)
            m.set_params(**base_params)

            # set random_state if model supports it
            if "random_state" in m.get_params():
                m.set_params(random_state=seed)

            m.fit(Xtr, ytr)
            pred = m.predict(Xte)
            fold_rmse = rmse(yte, pred)

            fold_rows.append({
                "label": label,
                "fold": fold_idx,
                "heldout_subject": subj,
                "seed": seed,
                "rmse": fold_rmse,
                "n_test_points": len(te),
            })

            r = permutation_importance(
                m,
                Xte, yte,
                n_repeats=N_REPEATS_PERM,
                random_state=seed,
                scoring=neg_rmse_scorer,
            )
            perm_runs.append(r.importances_mean)

    metrics_df = pd.DataFrame(fold_rows)
    metrics_path = outdir / f"metrics_{label}.csv"
    metrics_df.to_csv(metrics_path, index=False)

    print(f"[{label}] LOSO RMSE over (fold×seed): mean={metrics_df['rmse'].mean():.4f}, std={metrics_df['rmse'].std():.4f}")
    print(f"[{label}] Saved metrics: {metrics_path}")

    perm_mat = np.vstack(perm_runs)  # (n_runs, n_features)
    mean_imp = perm_mat.mean(axis=0)
    std_imp = perm_mat.std(axis=0)
    ci_low = np.quantile(perm_mat, 0.025, axis=0)
    ci_high = np.quantile(perm_mat, 0.975, axis=0)

    imp_df = pd.DataFrame({
        "Feature": feature_names,
        "Importance_mean": mean_imp,
        "Std": std_imp,
        "CI_low": ci_low,
        "CI_high": ci_high,
    }).sort_values("Importance_mean", ascending=False)

    imp_path = outdir / f"importance_{label}.csv"
    imp_df.to_csv(imp_path, index=False)

    # Plot
    plot_df = imp_df.sort_values("Importance_mean", ascending=True)
    plt.figure(figsize=(10, 6))
    plt.barh(plot_df["Feature"], plot_df["Importance_mean"])
    plt.title(f"Permutation importance on held-out subjects (LOSO) — {label}")
    plt.xlabel("Importance (drop in -RMSE when permuted)")
    plt.tight_layout()
    fig_path = outdir / f"importance_{label}.png"
    plt.savefig(fig_path, dpi=300)
    plt.close()

    print(f"[{label}] Saved importance: {imp_path}")
    print(f"[{label}] Saved plot: {fig_path}")

    return imp_df


# =========================================================
# 5) MAIN
# =========================================================

def prepare_train_df(df: pd.DataFrame, train_group: Optional[str]) -> pd.DataFrame:
    out = df.copy()
    if train_group is not None:
        out = out[out["Group"] == train_group].copy()
    out = encode_sex(out)

    # force numeric
    for c in ["Time", "Tcore", "Activity", "HeartRate", TARGET]:
        if c in out.columns:
            out[c] = pd.to_numeric(out[c], errors="coerce")

    # drop rows with missing in required cols
    required = ["Tcore", "Activity", "HeartRate", "Sex_Encoded", TARGET]
    if "Time" in out.columns:
        required_time = ["Time"] + required
    else:
        required_time = required

    out = out.dropna(subset=required_time).copy()
    return out


def run_experiment(
    model_name: str = "rf",           # "rf" or "hgb"
    train_group: Optional[str] = "Non-torpor",  # or None for all
):
    ensure_outdir(OUTDIR)

    df = load_and_merge_all(XLSX_PATH, SHEET_CONFIG)
    train_df = prepare_train_df(df, train_group=train_group)

    if train_df["Subject_ID"].nunique() < 2:
        raise ValueError("Need at least 2 subjects after filtering/cleaning for LOSO.")

    y = train_df[TARGET].values.astype(float)
    groups = train_df["Subject_ID"].values.astype(str)

    # -------- WITH TIME --------
    X1 = train_df[FEATURES_WITH_TIME].copy()
    tuned1, params1 = tune_once(X1, y, groups, spec=TuneSpec(model_name=model_name, random_state=0))

    label1 = f"{model_name}_with_time_train-{train_group or 'ALL'}"
    loso_eval_and_importance(
        tuned_estimator=tuned1,
        X=X1, y=y, groups=groups,
        feature_names=FEATURES_WITH_TIME,
        label=label1,
        outdir=OUTDIR
    )

    # -------- WITHOUT TIME --------
    X2 = train_df[FEATURES_NO_TIME].copy()
    tuned2, params2 = tune_once(X2, y, groups, spec=TuneSpec(model_name=model_name, random_state=0))

    label2 = f"{model_name}_no_time_train-{train_group or 'ALL'}"
    loso_eval_and_importance(
        tuned_estimator=tuned2,
        X=X2, y=y, groups=groups,
        feature_names=FEATURES_NO_TIME,
        label=label2,
        outdir=OUTDIR
    )

    print("\nDone. Outputs saved under:", OUTDIR.resolve())


if __name__ == "__main__":
    # Choose model_name="rf" (stable baseline) or "hgb" (often stronger)
    run_experiment(model_name="rf", train_group="Non-torpor")
