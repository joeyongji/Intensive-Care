def read_sheet_raw(sheet_name):
    return pd.read_excel(FILENAME, sheet_name=sheet_name, header=None)

def parse_grouped_timeseries_sheet(sheet_name):
    df = read_sheet_raw(sheet_name)
    group_row = df.iloc[0]
    sex_row = df.iloc[1] if df.shape[0] > 1 else pd.Series([np.nan] * df.shape[1])
    time_col = 0

    cols_by_group = {}
    for j in range(1, df.shape[1]):
        if pd.notna(group_row[j]):
            grp = str(group_row[j]).strip()
            cols_by_group.setdefault(grp, []).append(j)
    return df, cols_by_group, sex_row, time_col

def summarize_timeseries(df, time_col, value_col, baseline_max_time=5.0):
    time = pd.to_numeric(df.iloc[2:, time_col], errors="coerce").astype(float).values
    vals = pd.to_numeric(df.iloc[2:, value_col], errors="coerce").astype(float).values

    m_base = (time <= baseline_max_time)
    baseline = np.nanmean(vals[m_base]) if np.any(m_base) else np.nan
    vmin = np.nanmin(vals)
    mean = np.nanmean(vals)
    delta_min = vmin - baseline

    return {
        "baseline": float(baseline) if np.isfinite(baseline) else np.nan,
        "vmin": float(vmin) if np.isfinite(vmin) else np.nan,
        "mean": float(mean) if np.isfinite(mean) else np.nan,
        "delta_min": float(delta_min) if np.isfinite(delta_min) else np.nan,
    }

def torpor_from_tcore(tcore_df, tcore_col, thr, min_minutes, baseline_max_time=5.0):
    time = pd.to_numeric(tcore_df.iloc[2:, 0], errors="coerce").astype(float).values
    vals = pd.to_numeric(tcore_df.iloc[2:, tcore_col], errors="coerce").astype(float).values

    dt = np.nanmedian(np.diff(time))
    if not np.isfinite(dt) or dt <= 0:
        dt = 1.0

    below = vals < thr
    time_below = float(np.nansum(below) * dt)
    vmin = np.nanmin(vals)
    torpor = int((vmin < thr) and (time_below >= min_minutes))
    return torpor

def build_subject_table_from_tcore():
    tcore_df, tcore_cols_by_group, sex_row, time_col = parse_grouped_timeseries_sheet("Tcore")

    rows = []
    group_counts = {}
    for grp, cols in tcore_cols_by_group.items():
        group_counts[grp] = len(cols)
        for idx, col in enumerate(cols, start=1):
            sid = f"{grp}|{idx:02d}"
            sex = sex_row[col] if pd.notna(sex_row[col]) else np.nan
            rows.append({
                "subject_id": sid,
                "group": grp,
                "idx_in_group": idx,
                "sex": sex,
                "_tcore_col": col
            })

    subjects = pd.DataFrame(rows)
    return subjects, tcore_df, group_counts, time_col

def build_feature_table_from_sheet(sheet_name, prefix, subjects, group_counts, baseline_max_time=5.0):
    df, cols_by_group, _, time_col = parse_grouped_timeseries_sheet(sheet_name)

    feature_map = {}
    for grp, n_need in group_counts.items():
        cols = cols_by_group.get(grp, [])
        if len(cols) == 0:
            continue
        cols_take = cols[:min(len(cols), n_need)]
        for idx, col in enumerate(cols_take, start=1):
            sid = f"{grp}|{idx:02d}"
            feature_map[sid] = summarize_timeseries(df, time_col, col, baseline_max_time=baseline_max_time)

    rows = []
    for sid in subjects["subject_id"].tolist():
        stats = feature_map.get(sid, {})
        row = {"subject_id": sid}
        for k, v in stats.items():
            row[f"{prefix}_{k}"] = v
        rows.append(row)

    return pd.DataFrame(rows)

