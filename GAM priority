def bootstrap_auc(x, y, n_boot=2000, seed=0):
    """
    Univariate AUC with bootstrap CI.
    Returns: auc (direction-free), ci_low, ci_high
    """
    rng = np.random.default_rng(seed)
    x = np.asarray(x).reshape(-1)
    y = np.asarray(y).astype(int)

    # If constant x or single-class y, return NaN
    if np.nanstd(x) == 0 or len(np.unique(y)) < 2:
        return np.nan, np.nan, np.nan

    # AUC direction-free: max(auc, 1-auc)
    try:
        auc0 = roc_auc_score(y, x)
        auc0 = max(auc0, 1 - auc0)
    except Exception:
        return np.nan, np.nan, np.nan

    aucs = []
    n = len(y)
    for _ in range(n_boot):
        idx = rng.integers(0, n, size=n)
        xb, yb = x[idx], y[idx]
        if len(np.unique(yb)) < 2 or np.nanstd(xb) == 0:
            continue
        try:
            a = roc_auc_score(yb, xb)
            aucs.append(max(a, 1 - a))
        except Exception:
            continue

    if len(aucs) < 200:
        return auc0, np.nan, np.nan

    lo, hi = np.quantile(aucs, [0.025, 0.975])
    return float(auc0), float(lo), float(hi)

def cv_perm_importance_ranking(df, y_col, feature_cols, add_covariates=None,
                               n_splits=4, n_repeats=100, seed=0):
    """
    Elastic-net logistic + repeated stratified CV
    output:
      - perm_importance_mean, perm_importance_ci
      - selection_freq (coef != 0 frequency)
    """
    add_covariates = add_covariates or []

    data = df[[y_col] + add_covariates + feature_cols].copy()
    data = data.replace([np.inf, -np.inf], np.nan).dropna()
    y = data[y_col].astype(int).values

    if len(np.unique(y)) < 2:
        raise ValueError("Only one class in y after filtering; cannot rank.")

    # build X: covariates + features
    X_parts = []
    cov_names = []

    # covariates: handle categorical -> codes
    for c in add_covariates:
        if str(data[c].dtype) == "category":
            X_parts.append(data[c].cat.codes.values.reshape(-1, 1))
        else:
            X_parts.append(pd.to_numeric(data[c], errors="coerce").values.reshape(-1, 1))
        cov_names.append(c)

    X_feat = data[feature_cols].astype(float).values
    X = np.hstack(X_parts + [X_feat]) if X_parts else X_feat
    all_names = cov_names + feature_cols

    # Model: elastic-net (saga) + standardize
    # Use class_weight balanced for rare events
    model = Pipeline([
        ("scaler", StandardScaler(with_mean=True, with_std=True)),
        ("clf", LogisticRegression(
            penalty="elasticnet",
            solver="saga",
            l1_ratio=0.5,          # we will tune slightly by trying a few values
            C=1.0,
            max_iter=5000,
            class_weight="balanced",
            random_state=seed
        ))
    ])

    # We do simple hyperparam sweep inside each split (tiny data, keep stable)
    l1_grid = [0.1, 0.3, 0.5, 0.7, 0.9]
    C_grid = [0.1, 0.3, 1.0, 3.0, 10.0]

    rkf = RepeatedStratifiedKFold(n_splits=n_splits, n_repeats=n_repeats, random_state=seed)

    # collect importance for feature columns only (exclude covariates)
    feat_idx = [all_names.index(f) for f in feature_cols]
    importances = {f: [] for f in feature_cols}
    selected = {f: 0 for f in feature_cols}
    total_fits = 0

    for train_idx, test_idx in rkf.split(X, y):
        Xtr, Xte = X[train_idx], X[test_idx]
        ytr, yte = y[train_idx], y[test_idx]

        # inner CV for hyperparams (very light)
        best_auc = -np.inf
        best_params = None
        inner = StratifiedKFold(n_splits=3, shuffle=True, random_state=seed)

        for l1 in l1_grid:
            for C in C_grid:
                aucs = []
                for itrn, ival in inner.split(Xtr, ytr):
                    m = Pipeline([
                        ("scaler", StandardScaler()),
                        ("clf", LogisticRegression(
                            penalty="elasticnet", solver="saga",
                            l1_ratio=l1, C=C, max_iter=5000,
                            class_weight="balanced",
                            random_state=seed
                        ))
                    ])
                    m.fit(Xtr[itrn], ytr[itrn])
                    # use decision_function; fallback to predict_proba
                    try:
                        score = m.decision_function(Xtr[ival])
                    except Exception:
                        score = m.predict_proba(Xtr[ival])[:, 1]
                    # AUC can error if fold becomes single-class (rare but possible)
                    if len(np.unique(ytr[ival])) < 2:
                        continue
                    aucs.append(roc_auc_score(ytr[ival], score))
                if len(aucs) == 0:
                    continue
                mean_auc = float(np.mean(aucs))
                if mean_auc > best_auc:
                    best_auc = mean_auc
                    best_params = (l1, C)

        if best_params is None:
            continue

        # fit best model on train
        l1, C = best_params
        model = Pipeline([
            ("scaler", StandardScaler()),
            ("clf", LogisticRegression(
                penalty="elasticnet", solver="saga",
                l1_ratio=l1, C=C, max_iter=5000,
                class_weight="balanced",
                random_state=seed
            ))
        ])
        model.fit(Xtr, ytr)
        total_fits += 1

        # selection frequency from coefficients (after scaling)
        coef = model.named_steps["clf"].coef_.reshape(-1)
        for f, idx in zip(feature_cols, feat_idx):
            if abs(coef[idx]) > 1e-8:
                selected[f] += 1

        # permutation importance on test set for FEATURES only
        # scoring AUC; use predict_proba
        def scorer(est, X_, y_):
            p = est.predict_proba(X_)[:, 1]
            if len(np.unique(y_)) < 2:
                return np.nan
            return roc_auc_score(y_, p)

        perm = permutation_importance(
            model, Xte, yte,
            scoring=scorer,
            n_repeats=50,
            random_state=seed
        )
        # perm.importances_mean corresponds to all columns in X
        for f, idx in zip(feature_cols, feat_idx):
            importances[f].append(float(perm.importances_mean[idx]))

    # aggregate
    rows = []
    for f in feature_cols:
        imp = np.array(importances[f], dtype=float)
        imp = imp[np.isfinite(imp)]
        if len(imp) == 0:
            mean_imp = np.nan
            lo = hi = np.nan
        else:
            mean_imp = float(np.mean(imp))
            lo, hi = np.quantile(imp, [0.025, 0.975])
            lo, hi = float(lo), float(hi)

        freq = selected[f] / max(total_fits, 1)
        rows.append({
            "feature": f,
            "perm_importance_mean": mean_imp,
            "perm_importance_ci_low": lo,
            "perm_importance_ci_high": hi,
            "selection_freq": freq,
            "n_fits": total_fits
        })

    out = pd.DataFrame(rows)
    return out, data

def build_final_ranking(df, y_col="torpor", feature_cols=None, covariates=None, seed=0):
    feature_cols = feature_cols or []
    covariates = covariates or []

    # univariate aucs
    auc_rows = []
    tmp = df[[y_col] + feature_cols].replace([np.inf, -np.inf], np.nan).dropna()
    y = tmp[y_col].astype(int).values

    for f in feature_cols:
        auc, lo, hi = bootstrap_auc(tmp[f].astype(float).values, y, n_boot=2000, seed=seed)
        auc_rows.append({"feature": f, "auc": auc, "auc_ci_low": lo, "auc_ci_high": hi})
    auc_df = pd.DataFrame(auc_rows)

    # multivariate perm importance + selection freq
    perm_df, used_data = cv_perm_importance_ranking(
        df=df, y_col=y_col, feature_cols=feature_cols, add_covariates=covariates,
        n_splits=4, n_repeats=100, seed=seed
    )

    # merge & rank
    res = perm_df.merge(auc_df, on="feature", how="left")

    # rank key: perm_importance_mean desc, then selection_freq desc, then auc desc
    res["rank"] = res.sort_values(
        by=["perm_importance_mean", "selection_freq", "auc"],
        ascending=[False, False, False]
    ).reset_index(drop=True).index + 1

    res = res.sort_values("rank")
    return res, used_data

